<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live visualizer: android.media.audiofx.Visualizer on the global output mix needs both. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Package visibility (Android 11+): App Remote must see the Spotify app; Custom Tabs for login. -->
    <queries>
        <package android:name="com.spotify.music" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".SpectraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spectra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Spectra"
            android:windowSoftInputMode="adjustResize">

            <!-- PKCE redirect: spectra://callback?code=...&state=... (must match the Spotify dashboard) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="callback" android:scheme="spectra" />
            </intent-filter>
        </activity>

        <!-- Launcher icon "Evening": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Evening"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_evening"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Midnight": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Midnight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_midnight"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Sunset": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Sunset"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sunset"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Aurora": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Aurora"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aurora"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Nebula": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Nebula"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nebula"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Ocean": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Ocean"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher icon "Black": exactly one of these aliases is enabled (see AppIcons). -->
        <activity-alias
            android:name=".icon.Black"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Spotify announces its audio session here (as it does for equalizer apps), so the
             visualizer can listen to Spotify only. -->
        <receiver
            android:name=".visualizer.SpotifyAudioSession$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
                <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
